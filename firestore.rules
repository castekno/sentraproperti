rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Properti collection
    match /dbproperti/{projectId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Cities collection
    match /dbcities/{cityId} {
      allow read: if true;
      allow write: if true;
    }

    // Documentation activities collection
    match /dbdocumentation/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
